# Copy to .env (never commit .env). Values below are placeholders.
ENV=dev                                   # dev | test | prod (prod enforces JWT_SECRET and COOKIE_SECURE)
# App connects as the restricted app_user role (RLS enforced)
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/superdes_dev
# Admin/owner connection, used ONLY by scripts/migrate.py
DATABASE_ADMIN_URL=postgresql://postgres@localhost:5432/superdes_dev
APP_USER_PASSWORD=change-me               # migrate.py sets app_user's password from this
JWT_SECRET=                               # required in prod, >= 32 random chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_TTL_SECONDS=3600
COOKIE_SECURE=1                           # set 0 only for local http://
COOKIE_SAMESITE=lax                       # lax | strict | none (none requires COOKIE_SECURE=1; needed if frontend and API are on different sites)
FRONTEND_ORIGIN=http://localhost:5173     # comma-separated allowed origins (CORS + CSRF origin check)
UPLOAD_DIR=                               # default backend/data/uploads
# Optional Supabase Storage backend (otherwise local disk)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=superdes
# Optional self-hosted AI (otherwise rule-based consultant / Pillow concept renderer)
OLLAMA_URL=
OLLAMA_MODEL=llama3.1
# Only for Ollama Cloud (OLLAMA_URL=https://ollama.com); never commit the real key.
OLLAMA_API_KEY=
COMFYUI_URL=
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
RENDER_WORKER=1                           # 0 disables the in-process render worker
RENDER_POLL_SECONDS=2
CURRENCY=EUR
